<Window x:Class="MCAppsTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="{DynamicResource AppIcon}"
        Title="MCNexus"
        Width="850"
        Height="800"
        MinWidth="760"
        MinHeight="680"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Proxima Nova, Segoe UI"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="LicenseCardTemplate">
            <Button Style="{StaticResource LicenseCardButtonStyle}"
                    Tag="{Binding}"
                    Click="LicenseCard_Click"
                    IsEnabled="{Binding DataContext.CanInteract, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border Background="{Binding CardBackground}"
                        Padding="14"
                        MinHeight="95">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BaseTextBlock}"
                                       Text="{Binding PluginName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Style="{StaticResource BaseTextBlock}"
                                       Text="{Binding EditionBadge}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding EditionBrush}"
                                       Margin="6,1,0,0"
                                       Visibility="{Binding EditionBadgeVisibility}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                   Text="{Binding SecondaryText}"
                                   FontSize="12"
                                   Foreground="{Binding SecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource BaseTextBlock}"
                                       Text="{Binding InstalledVersionText}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextStrongBrush}"/>
                            <TextBlock Style="{StaticResource BaseTextBlock}"
                                       Text="{Binding AvailableVersionText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource StatusWarningBrush}"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding AvailableVersionVisibility}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="InstallStepTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Width="18"
                      Height="18"
                      VerticalAlignment="Top"
                      Margin="0,1,0,0">
                    <TextBlock Style="{StaticResource RunningStepIconTextBlockStyle}"
                               Text="{Binding Icon}"
                               FontSize="13"
                               Foreground="{Binding IconBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                   Text="{Binding Label}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{Binding TextBrush}"/>
                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                   Text="{Binding ErrorDetail}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource StatusErrorBrush}"
                                   Margin="8,0,0,0"
                                   Visibility="{Binding ErrorVisibility}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding DownloadVisibility}" Margin="0,8,0,0">
                        <ProgressBar Style="{StaticResource StepProgressBarStyle}"
                                     Width="220"
                                     HorizontalAlignment="Left"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ProgressValue}"/>
                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                   Text="{Binding ProgressText}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource BaseTextBlock}"
                               Text="C:\Program Files\Common Files\OFX\Plugins"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               Foreground="{StaticResource TextFaintBrush}"
                               Margin="0,5,0,0"
                               Visibility="{Binding InstallPathVisibility}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PreviousVersionTemplate">
            <Grid Margin="0,0,0,8" Background="#0AFFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,10">
                    <TextBlock Style="{StaticResource BaseTextBlock}"
                               Text="{Binding VersionText}"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextStrongBrush}"/>
                    <TextBlock Style="{StaticResource BaseTextBlock}"
                               Text="{Binding Channel}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{Binding ChannelBrush}"
                               Margin="8,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Install"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        MinHeight="32"
                        Padding="13,5"
                        Margin="0,8,14,8"
                        Tag="{Binding}"
                        Click="InstallPreviousVersion_Click"
                        IsEnabled="{Binding DataContext.CanInteract, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppBackgroundBrush}"
                BorderThickness="0">
            <Grid>
                <TextBlock Style="{StaticResource BaseTextBlock}"
                           Text="MCNexus"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="MinimizeWindow_Click"/>
                    <Button Content="&#xE8BB;"
                            Style="{StaticResource CloseWindowControlButtonStyle}"
                            Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource MainVerticalScrollBarStyle}"/>
            </ScrollViewer.Resources>

            <StackPanel x:Name="MainContent"
                        Margin="28"
                        Width="780"
                        HorizontalAlignment="Center">

                <StackPanel Margin="0,0,0,24">
                    <TextBlock Style="{StaticResource BaseTextBlock}"
                               Text="Apps Tools for Color"
                               FontSize="34"
                               FontWeight="Regular"/>
                    <TextBlock Style="{StaticResource BaseTextBlock}"
                               Text="Plugin and license management"
                               FontSize="18"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource PanelSurfaceStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource BaseTextBlock}"
                                       Text="Active licenses"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextStrongBrush}"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SyncIconTextBlockStyle}"
                                           Text="{Binding SyncIcon}"
                                           FontSize="13"
                                           Foreground="{Binding SyncBrush}"
                                           Margin="0,1,6,0"/>
                                <TextBlock Style="{StaticResource BaseTextBlock}"
                                           Text="{Binding SyncMessage}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding SyncBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding SyncNoticeVisibility}" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BaseTextBlock}"
                                       Text="{Binding LastUpdatedText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       Margin="0,0,12,0"/>
                            <Button Grid.Column="1"
                                    Content="{Binding RetrySyncText}"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    MinHeight="30"
                                    Padding="12,4"
                                    Click="RetrySync_Click"
                                    IsEnabled="{Binding CanRetrySync}"/>
                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource BaseTextBlock}"
                                       Text="{Binding SyncNoticeMessage}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource StatusErrorBrush}"
                                       Margin="12,5,0,0"/>
                        </Grid>

                        <StackPanel Visibility="{Binding EmptyLicensesVisibility}"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0">
                            <TextBlock Style="{StaticResource BaseTextBlock}"
                                       Text="No active licenses"
                                       FontSize="14"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"/>
                            <Button Content="Purchase a License"
                                    Style="{StaticResource PurchaseButtonStyle}"
                                    Margin="0,14,0,0"
                                    Visibility="{Binding PurchaseButtonVisibility}"
                                    Click="PurchaseLicense_Click"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Licenses}"
                                      ItemTemplate="{StaticResource LicenseCardTemplate}"
                                      Visibility="{Binding LicenseListVisibility}"
                                      Margin="-6,16,-6,-12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="StatusPanel"
                        Style="{StaticResource PanelSurfaceStyle}"
                        Margin="0,0,0,24"
                        Visibility="{Binding SelectedLicenseVisibility}">
                    <StackPanel DataContext="{Binding SelectedLicense}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="245"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{Binding StatusBadgeBackground}"
                                    Padding="18"
                                    VerticalAlignment="Top">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource StatusIconTextBlockStyle}"
                                                   Text="{Binding StatusIcon}"
                                                   FontSize="18"
                                                   Foreground="{Binding StatusBrush}"
                                                   Margin="0,2,8,0"/>
                                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                                   Text="{Binding StatusTitle}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding StatusBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource BaseTextBlock}"
                                               Text="{Binding StatusMessage}"
                                               FontSize="14"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Style="{StaticResource BaseTextBlock}"
                                               Text="License"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,16,0,0"/>
                                    <TextBlock Style="{StaticResource BaseTextBlock}"
                                               Text="{Binding LicenseDisplayText}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource TextStrongBrush}"
                                               Margin="0,4,0,0"/>

                                    <StackPanel Visibility="{Binding ActivationsVisibility}">
                                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                                   Text="Activations"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,16,0,0"/>
                                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                                   Text="{Binding ActivationUsage}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource TextStrongBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BaseTextBlock}"
                                               Text="Plugin"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                                   Text="{Binding PluginName}"
                                                   FontSize="16"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource TextStrongBrush}"/>
                                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                                   Text="{Binding DetailBadge}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding EditionBrush}"
                                                   Visibility="{Binding DetailBadgeVisibility}"
                                                   Margin="8,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Style="{StaticResource BaseTextBlock}"
                                           Text="{Binding InstallationTargetText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource StatusInfoBrush}"
                                           Visibility="{Binding InstallationTargetVisibility}"
                                           Margin="0,12,0,0"/>

                                <ItemsControl ItemsSource="{Binding InstallationSteps}"
                                              ItemTemplate="{StaticResource InstallStepTemplate}"
                                              Visibility="{Binding InstallationProgressVisibility}"
                                              Margin="0,10,0,0"/>

                                <StackPanel Visibility="{Binding DetailsVisibility}" Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource BaseTextBlock}"
                                               Text="Current version"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                                   Text="{Binding InstalledVersionValue}"
                                                   FontSize="16"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource TextStrongBrush}"/>
                                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                                   Text="{Binding NewVersionText}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding StatusBrush}"
                                                   Visibility="{Binding NewVersionVisibility}"
                                                   Margin="10,1,0,0"/>
                                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                                   Text="{Binding FeedbackMessage}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding FeedbackBrush}"
                                                   Visibility="{Binding FeedbackVisibility}"
                                                   Margin="10,1,0,0"/>
                                    </StackPanel>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BaseTextBlock}" Text="Activation date" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Style="{StaticResource BaseTextBlock}" Text="{Binding ActivationDate}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextStrongBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource BaseTextBlock}" Text="Plugin update date" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Style="{StaticResource BaseTextBlock}" Text="{Binding PluginUpdateDate}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextStrongBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Visibility="{Binding DeactivationDateVisibility}">
                                            <TextBlock Style="{StaticResource BaseTextBlock}" Text="Deactivation date" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Style="{StaticResource BaseTextBlock}" Text="{Binding DeactivationDate}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextStrongBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Visibility="{Binding PreviousVersionsSectionVisibility}" Margin="0,18,0,0">
                                        <Button Style="{StaticResource PlainButtonStyle}" Click="TogglePreviousVersions_Click">
                                            <Grid Background="#0FFFFFFF">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource BaseTextBlock}"
                                                           Text="Previous versions"
                                                           FontSize="15"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextStrongBrush}"
                                                           Margin="14,12"/>
                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource IconTextBlock}"
                                                           Text="{Binding PreviousVersionsChevron}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextStrongBrush}"
                                                           Margin="14,12"/>
                                            </Grid>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding FilteredPreviousVersions}"
                                                      ItemTemplate="{StaticResource PreviousVersionTemplate}"
                                                      Visibility="{Binding PreviousVersionsVisibility}"
                                                      Margin="0,10,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                   Text="{Binding DeactivationErrorDetail}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource StatusErrorBrush}"
                                   Margin="0,18,0,0"
                                   Visibility="{Binding DeactivationErrorVisibility}"/>

                        <UniformGrid Rows="1"
                                     Visibility="{Binding InstallationFailedActionsVisibility}"
                                     Margin="0,18,0,0"
                                     HorizontalAlignment="Stretch">
                            <Button Content="Retry Installation"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Margin="6,0"
                                    HorizontalAlignment="Stretch"
                                    Click="RetryInstallation_Click"/>
                            <Button Content="Cancel"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Margin="6,0"
                                    HorizontalAlignment="Stretch"
                                    Click="CancelInstallation_Click"/>
                        </UniformGrid>

                        <UniformGrid Rows="1"
                                     Visibility="{Binding SuspendedActionsVisibility}"
                                     Margin="0,18,0,0"
                                     HorizontalAlignment="Stretch">
                            <Button Content="Online Support"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Margin="6,0"
                                    HorizontalAlignment="Stretch"
                                    Click="SupportOnline_Click"/>
                        </UniformGrid>

                        <ItemsControl ItemsSource="{Binding ActionItems}"
                                      Visibility="{Binding ActionItemsVisibility}"
                                      Margin="0,18,0,0"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Text}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Background="{Binding Background}"
                                            BorderBrush="{Binding BorderBrush}"
                                            Foreground="{Binding Foreground}"
                                            Margin="6,0"
                                            HorizontalAlignment="Stretch"
                                            Tag="{Binding Kind}"
                                            Click="LicenseAction_Click"
                                            IsEnabled="{Binding DataContext.CanInteract, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="ActivationPanel"
                        Style="{StaticResource PanelSurfaceStyle}"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PlainButtonStyle}"
                                    Click="ToggleActivationPanel_Click"
                                    IsEnabled="{Binding CanInteract}">
                                <TextBlock Style="{StaticResource BaseTextBlock}"
                                           Text="{Binding ActivationPanelTitle}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Button>
                            <TextBlock Style="{StaticResource BaseTextBlock}"
                                       Text="{Binding ActivationErrorMessage}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource StatusErrorBrush}"
                                       Margin="10,1,0,0"
                                       Visibility="{Binding ActivationErrorVisibility}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ActivationFormVisibility}" Margin="0,18,0,0">
                            <Grid>
                                <TextBox x:Name="LicenseKeyTextBox"
                                         Style="{StaticResource KeyTextBoxStyle}"
                                         Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="43"
                                         IsEnabled="{Binding CanInteract}"/>
                                <TextBlock Style="{StaticResource BaseTextBlock}"
                                           Text="Paste your key here"
                                           FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="16,0,16,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding LicenseKeyPlaceholderVisibility}"/>
                            </Grid>
                            <Button Content="Activate Plugin"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Margin="0,18,0,0"
                                    Click="ActivateButton_Click"
                                    IsEnabled="{Binding CanActivate}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FingerprintTextBlock"
                                   Style="{StaticResource BaseTextBlock}"
                                   Text="{Binding FingerprintText}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Content="Copy for diagnostics"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                MinHeight="32"
                                Padding="12,4"
                                Margin="10,0,0,0"
                                Click="CopyDiagnostics_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                   Text="{Binding AppClientVersionText}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                   Text="{Binding SupportCodeText}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource StatusErrorBrush}"
                                   Margin="12,2,0,0"
                                   Visibility="{Binding SupportCodeVisibility}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Visibility="{Binding AppUpdateBannerVisibility}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Padding="14,10"
                Background="{StaticResource AppBackgroundBrush}"
                BorderBrush="{StaticResource UpdateGradientBrush}"
                BorderThickness="1.5"
                CornerRadius="12">
            <Border Background="{StaticResource PanelSurfaceBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconTextBlock}"
                               Text="&#xE896;"
                               FontSize="22"
                               Foreground="{StaticResource StatusWarningBrush}"
                               Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                   Text="Update available"
                                   FontSize="13"
                                   FontWeight="Bold"/>
                        <TextBlock Style="{StaticResource BaseTextBlock}"
                                   Text="{Binding AppUpdateVersionText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <Button Content="Update"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Background="{StaticResource UpdateGradientBrush}"
                            MinHeight="28"
                            Padding="12,4"
                            Margin="14,0,0,0"
                            Click="AppUpdate_Click"/>
                    <Button Style="{StaticResource PlainButtonStyle}"
                            Margin="10,0,0,0"
                            Click="DismissAppUpdate_Click">
                        <Border Background="#14FFFFFF" Width="18" Height="18" CornerRadius="9">
                            <TextBlock Style="{StaticResource BaseTextBlock}"
                                       Text="X"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <Grid x:Name="ElevationOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="100"
              Background="#B8000000"
              Visibility="Collapsed">
            <Border Width="540"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource AppBackgroundBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock Style="{StaticResource BaseTextBlock}"
                               Text="Administrator permission is required"
                               FontSize="23"
                               FontWeight="SemiBold"
                               TextAlignment="Center"/>

                    <TextBlock Margin="0,18,0,0"
                               Style="{StaticResource BaseTextBlock}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"
                               LineHeight="21"
                               TextAlignment="Center"
                               Text="MCNexus requires administrator permission to install and manage plugins in the system-wide OFX folder."/>

                    <TextBlock x:Name="ElevationStatusText"
                               Margin="0,20,0,0"
                               Style="{StaticResource BaseTextBlock}"
                               Foreground="{StaticResource StatusWarningBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextAlignment="Center"/>

                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource BaseTextBlock}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13"
                               TextAlignment="Center"
                               Text="No plugin files were changed."/>

                    <StackPanel Margin="0,28,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="Close MCNexus"
                                MinWidth="130"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Click="ElevationClose_Click"/>
                        <Button Content="Try Again"
                                MinWidth="120"
                                Margin="12,0,0,0"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Click="ElevationTryAgain_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
